# Copy to .env and fill in. Required: MUSIC_DIR, DOWNLOADS_DIR and the sign-in details.

# ---- sign-in for the web app ----
MUSICFLOW_USERNAME=
# Make it with: docker compose run --rm --entrypoint python musicflow -m formlogin hash
# Changing it signs every device out.
MUSICFLOW_PASSWORD_HASH=
# Only if nothing untrusted can reach the app: MUSICFLOW_AUTH=off turns sign-in off
#MUSICFLOW_AUTH=off

# ---- folders on this machine ----
# Your music library (Lidarr's root folder)
MUSIC_DIR=/srv/music
# slskd's download folder
DOWNLOADS_DIR=/srv/slskd/downloads
# Where Lidarr sees those two folders inside its container. musicflow mounts them at the same
# paths, so the paths it hands Lidarr make sense to Lidarr.
MUSIC_PATH=/music
DOWNLOADS_PATH=/downloads

# ---- the other apps (reached by container name on DOCKER_NETWORK) ----
# The Docker network Lidarr, slskd and Jellyfin are on (create it with `docker network create media`)
DOCKER_NETWORK=media
# Add the URL base if you set one in the app (e.g. http://lidarr:8686/lidarr)
LIDARR_URL=http://lidarr:8686
SLSKD_URL=http://slskd:5030
JELLYFIN_URL=http://jellyfin:8096

# ---- API keys ----
# Either point at each app's config file and musicflow reads the key from it...
LIDARR_CONFIG=/path/to/lidarr/config/config.xml
SLSKD_CONFIG=/path/to/slskd/config/slskd.yml
# ...or paste the keys here (Lidarr: Settings > General; slskd: web.authentication.api_keys)
LIDARR_API_KEY=
SLSKD_API_KEY=
# Jellyfin > Dashboard > API Keys > +  (optional: lets musicflow start a music library scan)
JELLYFIN_API_KEY=

# ---- other ----
# User and group new files are written as (match your media apps)
PUID=1000
PGID=1000
TZ=UTC
# iTunes store country used for cover art
ITUNES_COUNTRY=us
# Optional: an email or URL for the MusicBrainz User-Agent, as they ask for contact info
MB_CONTACT=
